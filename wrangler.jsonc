{
  // Cloudflare Worker "playaz" (technischer Name bleibt, Marke ist PlaySaal): statische Dateien aus ./public; nur BlockSaal-Herausforderungen laufen zuerst durch das Skript.
  // Name NICHT umbenennen: er bestimmt die alte Adresse playaz.cf-922.workers.dev, auf der die Spielstände der Spieler liegen.
  "name": "playaz",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/spiele/blocksaal", "/og/blocksaal/*"]
  },
  // Ausdrücklich an: Sobald "routes" (z. B. Custom Domain playsaal.com) eingetragen werden,
  // würde Wrangler workers.dev sonst automatisch abschalten – und damit den Spielstand-Umzug unmöglich machen.
  "workers_dev": true,
  // Hauptadresse: Cloudflare legt DNS-Eintrag und Zertifikat für playsaal.com selbst an (Zone ist Active).
  "routes": [{ "pattern": "playsaal.com", "custom_domain": true }],
  // Branch-Vorschauen (Worker Previews) nutzen dieselben Einstellungen wie Produktion
  "previews": {}
}
